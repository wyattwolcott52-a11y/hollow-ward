{
  "name": "hollow-ward",
  "productName": "The Hollow Ward",
  "version": "1.3.0",
  "description": "A short horror game. Find the fuses, power the exit, don't be found.",
  "main": "main.js",
  "author": "Wyatt Wolcott",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.0"
  },
  "build": {
    "appId": "com.hollowward.game",
    "productName": "The Hollow Ward",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  }
}